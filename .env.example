# Copy to .env and fill in real values:
#   cp .env.example .env

# --- App ---
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000

# --- PostgreSQL ---
DATABASE_URL=postgres://myna:myna_secret@localhost:5432/myna_archive
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=myna
DB_PASSWORD=myna_secret
DB_DATABASE=myna_archive
DB_SYNC=true
DB_LOGGING=true

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=myna-archive
CLOUDINARY_THUMB_TRANSFORM=c_fill,w_480,h_270,q_auto:eco
CLOUDINARY_IMAGE_TRANSFORM=q_auto:best
CLOUDINARY_VIDEO_POSTER_TRANSFORM=so_0,w_480,h_270,c_fill,q_auto:eco

# --- Upload limits (bytes) ---
# 50 MB / 1 GB
MAX_IMAGE_BYTES=52428800
MAX_VIDEO_BYTES=1073741824
UPLOAD_CHUNK_BYTES=20971520
