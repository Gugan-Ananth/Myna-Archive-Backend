# Copy to .env and fill in real values:
#   cp .env.example .env

# --- App ---
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000

# --- PostgreSQL ---
DATABASE_URL=postgres://myna:myna_secret@localhost:5432/myna_archive
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=myna
DB_PASSWORD=myna_secret
DB_DATABASE=myna_archive
DB_SYNC=true
DB_LOGGING=true

# --- Bunny.net Edge Storage (images) ---
# Dashboard: Storage → zone → FTP & API Access
BUNNY_STORAGE_ZONE_NAME=
BUNNY_STORAGE_PASSWORD=
# Region endpoint, e.g. storage.bunnycdn.com | ny.storage.bunnycdn.com | la.storage.bunnycdn.com
BUNNY_STORAGE_HOSTNAME=storage.bunnycdn.com
BUNNY_STORAGE_FOLDER=myna-archive

# Pull Zone hostname linked to the storage zone (image CDN delivery)
# Enable Bunny Optimizer on the pull zone for thumbnail query transforms.
BUNNY_CDN_HOSTNAME=
BUNNY_IMAGE_THUMB_QUERY=width=480&height=270&aspect_ratio=16:9&quality=80
# Account API key (Dashboard → Account → API). Optional; used to purge CDN
# edge/Optimizer cache after Storage deletes so removed files stop serving.
BUNNY_API_KEY=

# --- Bunny Stream (videos) ---
# Dashboard: Stream → library → API
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
# CDN hostname from Stream library settings (e.g. vz-xxxxx.b-cdn.net)
BUNNY_STREAM_CDN_HOSTNAME=
# Progressive MP4 fallback resolution used in mediaUrl (library must enable MP4 fallback)
BUNNY_STREAM_DEFAULT_RESOLUTION=720
# TUS signature lifetime (seconds); allow long enough for 1 GB uploads
BUNNY_STREAM_UPLOAD_EXPIRE_SECONDS=86400

# --- Upload limits (bytes) ---
# 50 MB / 1 GB
MAX_IMAGE_BYTES=52428800
MAX_VIDEO_BYTES=1073741824
# Suggested client chunk size for large / TUS uploads (~20 MB)
UPLOAD_CHUNK_BYTES=20971520
